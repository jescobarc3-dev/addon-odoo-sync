# ── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sincronizador_sap

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ── Odoo ─────────────────────────────────────────────────────────────────────
ODOO_URL=https://tu-odoo.ejemplo.com
ODOO_DB=nombre_de_la_base
ODOO_USER=admin
ODOO_PASSWORD=

# ── App ──────────────────────────────────────────────────────────────────────
IS_WORKER=false
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:4000
COOKIE_SECURE=false   # Cambiar a true en producción (HTTPS)

# ── Admin panel JWT ─────────────────────────────────────────────────────────
# Generar con: openssl rand -hex 32
ADMIN_JWT_SECRET=
ADMIN_ENCRYPTION_KEY=
ADMIN_INITIAL_EMAIL=admin@tuempresa.com
ADMIN_INITIAL_PASSWORD=

# ── Portal usuario JWT ───────────────────────────────────────────────────────
# Generar con: openssl rand -hex 32
PORTAL_JWT_SECRET=
PORTAL_REFRESH_SECRET=
